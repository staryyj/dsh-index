    "./package.json": "./package.json"
  },
  "icon": "./icon.svg",
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "icon.svg",
    "assets",
    "locale",
    "docs"
  ],
  "keywords": [
    "dsh",
    "bid",
    "tender",
    "施工组织设计",
    "技术标",
    "附表"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-skill": "0.2.2-rc.5"
  }
